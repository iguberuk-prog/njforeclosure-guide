# Copy to .env.local for local development.
#
# Where lead submissions are mirrored (Bidnology CRM, TheAllAgent repo,
# POST /api/intake). Leave unset in production: the code defaults to
# https://bidnology.com/api/intake. For local work point it at the dashboard
# dev server:
NEXT_PUBLIC_INTAKE_API_URL=http://localhost:3010/api/intake
